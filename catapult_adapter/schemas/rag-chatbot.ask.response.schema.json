{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/rag-chatbot.ask.response.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["answer", "sources", "source_type", "usage"],
  "properties": {
    "answer": {
      "type": "string",
      "description": "The generated answer"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Document name (KB) or web result title"
          },
          "url": {
            "type": "string",
            "description": "Source URL (web results only)"
          }
        }
      },
      "description": "Citations. Empty when source_type is 'llm' or 'none'."
    },
    "source_type": {
      "type": "string",
      "enum": ["documents", "web", "llm", "none"],
      "description": "Where the answer came from. 'documents' = KB chunks, 'web' = Tavily, 'llm' = ungrounded LLM fallback, 'none' = greeting/closer/refusal."
    },
    "mode": {
      "type": "string",
      "enum": [
        "kb_grounded",
        "web_grounded",
        "llm_fallback",
        "conversational"
      ],
      "description": "Internal answer-mode label, mirrors the main app's chat_pg semantics."
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["retrieval_latency_ms"],
      "properties": {
        "retrieval_latency_ms": { "type": "integer", "minimum": 0 },
        "chunks_retrieved": { "type": "integer", "minimum": 0 },
        "embedding_tokens": { "type": "integer", "minimum": 0 },
        "generation_tokens": { "type": "integer", "minimum": 0 }
      }
    },
    "model_used": {
      "type": "string",
      "description": "The chat model used for answer generation"
    },
    "message": {
      "type": "string",
      "description": "Optional human-readable badge for the frontend (e.g. 'This answer is from web search')."
    }
  }
}
