{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/rag-chatbot.search.request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["query", "collection_id"],
  "properties": {
    "query": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "description": "Semantic search query"
    },
    "collection_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "minLength": 1,
      "maxLength": 128
    },
    "top_k": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50,
      "default": 10
    },
    "use_hybrid": {
      "type": "boolean",
      "description": "Force hybrid (vector + FTS + RRF) retrieval. If omitted, the adapter follows the same routing the main app uses (settings.ENABLE_HYBRID_RAG)."
    }
  }
}
