{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/rag-chatbot.ingest.response.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["collection_id", "documents_processed", "chunks_created"],
  "properties": {
    "collection_id": { "type": "string" },
    "documents_processed": { "type": "integer", "minimum": 0 },
    "chunks_created": { "type": "integer", "minimum": 0 },
    "documents_replaced": {
      "type": "integer",
      "minimum": 0,
      "description": "Count of incoming documents whose document_id matched an existing record (and so replaced its chunks)."
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["document_id", "error"],
        "properties": {
          "document_id": { "type": "string" },
          "error": { "type": "string" }
        }
      }
    }
  }
}
